#!/usr/bin/env bash
# Reformat selected videos to 9:16 (1080x1920), letterboxed (nothing cropped).
set -uo pipefail
notify() { command -v notify-send >/dev/null && notify-send -a "Ryoku Creator" "$1" "${2:-}"; }
# libx264 where ffmpeg has it. An ffmpeg built without it (Fedora's ffmpeg-free)
# would quietly write MPEG-4 Part 2 instead of H.264, so name OpenH264 there.
# Read the list whole: piped into grep -q under pipefail, ffmpeg can die of
# SIGPIPE part-way through it and read as missing.
encoders="$(ffmpeg -hide_banner -encoders 2>/dev/null)"
if grep -qw libx264 <<<"$encoders"; then
  video=(-c:v libx264)
else
  video=(-c:v libopenh264 -b:v 8M)
fi
n=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "${f,,}" in *.mp4 | *.mov | *.mkv | *.webm | *.avi | *.m4v) ;; *) continue ;; esac
  out="${f%.*}_9x16.mp4"
  if ffmpeg -nostdin -y -i "$f" \
    -vf "scale=1080:1920:force_original_aspect_ratio=decrease,pad=1080:1920:(ow-iw)/2:(oh-ih)/2:black,setsar=1" \
    "${video[@]}" -c:a copy "$out" 2>/dev/null; then
    n=$((n + 1))
    notify "Reformatted to 9:16" "$(basename "$out")"
  else
    notify "Reformat failed" "$(basename "$f")"
  fi
done <<<"$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
[ "$n" -gt 0 ] && notify "Done" "$n video(s) to 9:16"
