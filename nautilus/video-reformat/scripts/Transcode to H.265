#!/usr/bin/env bash
# Transcode to H.265/HEVC mp4 (~40% smaller; hvc1 tag = Apple/QuickTime playable).
set -uo pipefail
notify() { command -v notify-send >/dev/null && notify-send -a "Ryoku Creator" "$1" "${2:-}"; }
# libx265 where ffmpeg has it. An ffmpeg built without it (Fedora's ffmpeg-free)
# still carries the GPU encoders, so those are tried in turn: NVENC, then VA-API.
# Read the list whole: piped into grep -q under pipefail, ffmpeg can die of
# SIGPIPE part-way through it and read as missing.
available="$(ffmpeg -hide_banner -encoders 2>/dev/null)"
if grep -qw libx265 <<<"$available"; then
  encoders=(libx265)
else
  encoders=(hevc_nvenc hevc_vaapi)
fi
encode() { # encoder, source, output
  case $1 in
    libx265) ffmpeg -nostdin -y -i "$2" -c:v libx265 -crf 24 -preset medium -tag:v hvc1 -c:a aac -b:a 128k "$3" ;;
    hevc_nvenc) ffmpeg -nostdin -y -i "$2" -c:v hevc_nvenc -preset p5 -cq 24 -tag:v hvc1 -c:a aac -b:a 128k "$3" ;;
    hevc_vaapi)
      ffmpeg -nostdin -y -vaapi_device /dev/dri/renderD128 -i "$2" -vf format=nv12,hwupload \
        -c:v hevc_vaapi -qp 24 -tag:v hvc1 -c:a aac -b:a 128k "$3"
      ;;
  esac 2>/dev/null
}
n=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "${f,,}" in *.mp4 | *.mov | *.mkv | *.webm | *.avi | *.m4v) ;; *) continue ;; esac
  out="${f%.*}_h265.mp4"
  encoded=0
  for encoder in "${encoders[@]}"; do
    if encode "$encoder" "$f" "$out"; then
      encoded=1
      break
    fi
  done
  if [ "$encoded" -eq 1 ]; then
    n=$((n + 1))
    notify "Transcoded to H.265" "$(basename "$out")"
  else
    rm -f "$out"
    if [ "${encoders[0]}" = libx265 ]; then
      notify "Transcode failed" "$(basename "$f")"
    else
      notify "Transcode failed" "$(basename "$f"): this ffmpeg has no libx265, and the GPU's H.265 encoder is missing or refused the clip"
    fi
  fi
done <<<"$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
[ "$n" -gt 0 ] && notify "Done" "$n video(s) to H.265"
