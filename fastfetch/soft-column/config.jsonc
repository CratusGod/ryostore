// Soft Column - titled key/value list framed top and bottom by ANSI swatch bars
// Ported for Ryoku from awesome-fastfetch-collection (configs/aayushchalise/config.jsonc), MIT.
// ryoku:recolor keys=primary
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "left": 1,
      "right": 3,
      "top": 1
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "#c6a0f6"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
    },
    "break",
    {
      "type": "title",
      "keyWidth": 10
    },
    "break",
    {
      "type": "os",
      "key": " "
    },
    {
      "type": "kernel",
      "key": " "
    },
    {
      "type": "packages",
      "key": " "
    },
    {
      "type": "shell",
      "key": " "
    },
    {
      "type": "terminal",
      "key": " "
    },
    {
      "type": "wm",
      "key": " "
    },
    {
      "type": "display",
      "key": "󰍹 "
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": " "
    },
    {
      "type": "gpu",
      "format": "{2}",
      "key": " "
    },
    {
      "type": "memory",
      "key": "󰍛 "
    },
    {
      "type": "swap",
      "key": "󰾴 "
    },
    {
      "type": "disk",
      "key": " "
    },
    {
      "type": "uptime",
      "key": " "
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
    },
    "break"
  ]
}
