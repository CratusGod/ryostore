// Arc Reactor - industrial HUD readout: magenta labels, red divider rules, green status line
// Ported for Ryoku from awesome-fastfetch-collection (configs/5.jsonc), MIT.
// ryoku:recolor keys=primary title=secondary separator=outlineVariant output=tertiary
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin"
  },
  "display": {
    "separator": " \u27eb  ",
    "color": {
      "keys": "#d75fd7",
      "title": "#e23c2a",
      "separator": "#5f5f5f",
      "output": "#43d17a"
    },
    "constants": [
      "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    ]
  },
  "modules": [
    {
      "type": "title",
      "format": " {#title}{user-name}{#37}@{#33}{host-name} "
    },
    {
      "type": "custom",
      "format": "{#title}{$1}"
    },
    {
      "type": "os",
      "key": " \udb80\udf22  INTERFACE",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": " \udb81\ude80  CORE VER ",
      "format": "{2}"
    },
    {
      "type": "uptime",
      "key": " \udb84\udfab  ACTIVE   "
    },
    {
      "type": "custom",
      "format": "{#title}{$1}"
    },
    {
      "type": "cpu",
      "key": " \udb83\udee0  REACTOR  ",
      "format": "{1} @ {6}"
    },
    {
      "type": "gpu",
      "key": " \udb82\udcae  VISUALS  ",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": " \udb80\udf5b  BUFFER   ",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "disk",
      "key": " \udb80\udeca  STORAGE  ",
      "format": "{1} / {2} ({3})",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "{#title}{$1}"
    },
    {
      "type": "shell",
      "key": " \uf489  SHELL    ",
      "format": "{1} {4}"
    },
    {
      "type": "wm",
      "key": " \udb84\udcac  H.U.D    ",
      "format": "{1}"
    },
    {
      "type": "terminal",
      "key": " \ue795  CONSOLE  "
    },
    {
      "type": "custom",
      "format": "{#title}{$1}"
    },
    {
      "type": "battery",
      "key": " \udb85\udc0b  POWER    ",
      "format": "{capacity} [{status}]"
    },
    {
      "type": "custom",
      "format": "{#output} \udb81\udf64 STATUS: [ ONLINE ]  \udb81\udf64 THREATS: [ ZERO ]"
    },
    {
      "type": "break"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "block": {
        "range": [
          1,
          6
        ]
      }
    }
  ]
}
