// Deep Specs - arrow-separated tree in red, green, yellow with detailed CPU/GPU/host rows
// Ported for Ryoku from awesome-fastfetch-collection (configs/ghosttree/config.jsonc), MIT.
// ryoku:recolor keys=primary title=secondary separator=tertiary
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.local/share/ryoku/fastfetch/deep-specs/cat.png",
    "width": 16,
    "height": 13,
    "padding": {
      "left": 1,
      "right": 3,
      "top": 1
    }
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "#e06c75",
      "title": "#98c379",
      "separator": "#e5c07b"
    }
  },
  "modules": [
    "break",
    "break",
    "break",
    {
      "type": "os",
      "key": "OS   "
    },
    {
      "type": "packages",
      "format": "{?pacman}{pacman}{?}{?rpm}{rpm}{?}{?xbps}{xbps}{?}",
      "key": " ├ 󰏖 "
    },
    {
      "type": "shell",
      "key": " └  "
    },
    "break",
    {
      "type": "wm",
      "key": "WM   ",
      "keyColor": "title"
    },
    {
      "type": "wmtheme",
      "key": " ├ 󰉼 ",
      "keyColor": "title"
    },
    {
      "type": "icons",
      "key": " ├ 󰀻 ",
      "keyColor": "title"
    },
    {
      "type": "cursor",
      "key": " ├  ",
      "keyColor": "title"
    },
    {
      "type": "terminal",
      "key": " ├  ",
      "keyColor": "title"
    },
    {
      "type": "terminalfont",
      "key": " └  ",
      "keyColor": "title"
    },
    "break",
    {
      "type": "host",
      "format": "{1}",
      "key": "PC   ",
      "keyColor": "separator"
    },
    {
      "type": "cpu",
      "format": "{1} ({3}) @ {7}",
      "key": " ├  ",
      "keyColor": "separator"
    },
    {
      "type": "gpu",
      "format": "{2}",
      "key": " ├ 󰢮 ",
      "keyColor": "separator"
    },
    {
      "type": "memory",
      "key": " ├  ",
      "keyColor": "separator"
    },
    {
      "type": "disk",
      "key": " ├ 󰋊 ",
      "keyColor": "separator"
    },
    {
      "type": "monitor",
      "format": "{width}x{height} @ {refresh-rate} Hz",
      "key": " └  ",
      "keyColor": "separator"
    },
    "break"
  ]
}
