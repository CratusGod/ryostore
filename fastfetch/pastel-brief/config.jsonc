// Pastel Brief - airy Catppuccin readout: the distribution's small logo, pastel nerd-font keys, colour dots
// Ported for Ryoku from awesome-fastfetch-collection (configs/win-11-config), MIT.
// ryoku:recolor keys=primary title=secondary
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small" },
  "display": {
    "separator": " ",
    "color": { "keys": "#89dceb", "title": "#f5c2e7" }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{#title}{user-name}{#38;2;205;214;244}@{#keys}{host-name}" },
    "break",
    { "type": "os", "key": "{#keys}\uF31A" },
    { "type": "cpu", "key": "{#title}\uF4BC" },
    { "type": "board", "key": "{#38;2;250;179;135}\uDB81\uDE97" },
    { "type": "memory", "key": "{#38;2;166;227;161}\uEFC5", "format": "{used} / {total} ({percentage})" },
    { "type": "disk", "key": "{#38;2;148;226;213}\uF0C7" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
