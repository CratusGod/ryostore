// Full Audit - three tree-bracketed sections (system/software/hardware) in magenta, green, yellow
// Ported for Ryoku from awesome-fastfetch-collection (configs/3.jsonc), MIT.
// ryoku:recolor keys=primary title=secondary separator=tertiary
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "padding": { "top": 1, "left": 1, "right": 2 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#c678dd",
      "title": "#98c379",
      "separator": "#e5c07b"
    }
  },
  "modules": [
    {
      "type": "os",
      "key": "\u256d\u2500\uf31a"
    },
    {
      "type": "kernel",
      "key": "\u251c\u2500\uf17c",
      "format": "{1} {2}"
    },
    {
      "type": "packages",
      "key": "\u251c\u2500\udb80\udfd6"
    },
    {
      "type": "wm",
      "key": "\u2570\u2500\uf2d2"
    },
    "break",
    {
      "type": "terminal",
      "key": "\u256d\u2500\uea85",
      "keyColor": "title"
    },
    {
      "type": "disk",
      "key": "\u251c\u2500\uf0a0",
      "keyColor": "title"
    },
    {
      "type": "battery",
      "key": "\u251c\u2500\uf242",
      "keyColor": "title"
    },
    {
      "type": "sound",
      "key": "\u251c\u2500\uf028",
      "keyColor": "title"
    },
    {
      "type": "terminalfont",
      "key": "\u251c\u2500\uf031",
      "keyColor": "title"
    },
    {
      "type": "shell",
      "key": "\u2570\u2500\uf489",
      "keyColor": "title"
    },
    "break",
    {
      "type": "host",
      "key": "\u256d\u2500\uf109",
      "keyColor": "separator"
    },
    {
      "type": "cpu",
      "key": "\u251c\u2500\udb80\udf5b",
      "keyColor": "separator"
    },
    {
      "type": "gpu",
      "key": "\u251c\u2500\udb81\ude1a",
      "keyColor": "separator"
    },
    {
      "type": "display",
      "key": "\u251c\u2500\udb80\udf79",
      "keyColor": "separator"
    },
    {
      "type": "memory",
      "key": "\u251c\u2500\udb81\udc6d",
      "keyColor": "separator"
    },
    {
      "type": "swap",
      "key": "\u251c\u2500\udb81\udce1",
      "keyColor": "separator"
    },
    {
      "type": "uptime",
      "key": "\u2570\u2500\udb80\udd50",
      "keyColor": "separator"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[1m\u001b[31m  \u001b[1m\u001b[32m  \u001b[1m\u001b[33m  \u001b[1m\u001b[34m  \u001b[1m\u001b[35m  \u001b[1m\u001b[36m  \u001b[1m\u001b[37m  \u001b[1m\u001b[30m       \u001b[1m\u001b[91m  \u001b[1m\u001b[92m  \u001b[1m\u001b[93m  \u001b[1m\u001b[94m  \u001b[1m\u001b[95m  \u001b[1m\u001b[96m  \u001b[1m\u001b[97m  \u001b[1m\u001b[90m"
    }
  ]
}
