// Control Room - four-panel boxed dashboard (system/desktop/resources/software) with dotted rails
// Ported for Ryoku from awesome-fastfetch-collection (configs/rorfetch), MIT.
// ryoku:recolor keys=primary title=secondary separator=outline output=onSurface
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ",
    "disableLinewrap": true,
    "brightColor": true,
    "color": {
      "keys": "#870000",
      "title": "#87ff00",
      "separator": "#5f5f5f",
      "output": "#d0d0d0"
    },
    "key": {
      "type": "string",
      "width": 0,
      "paddingLeft": 0
    },
    "bar": {
      "width": 16,
      "char": {
        "elapsed": "█",
        "total": "░"
      },
      "border": null,
      "color": {
        "elapsed": "118",
        "total": "59"
      }
    },
    "percent": {
      "type": [
        "bar"
      ],
      "ndigits": 0,
      "color": {
        "green": "118",
        "yellow": "178",
        "red": "196"
      }
    }
  },
  "general": {
    "detectVersion": true,
    "thread": true
  },
  "modules": [
    {
      "type": "custom",
      "format": " {#keys}╭──── {#title}󰌽  SYSTEM {#keys}───────────────────────────────────╮"
    },
    {
      "type": "title",
      "fqdn": false,
      "color": {
        "user": "118",
        "at": "59",
        "host": "195"
      },
      "key": " {#keys}│ {#title} {#@141}User      ",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "host",
      "key": " {#keys}│ {#title}󰇄 {#@141}Host      ",
      "format": "{name}"
    },
    {
      "type": "os",
      "key": " {#keys}│ {#title}󰌽 {#@141}OS        ",
      "format": "{pretty-name} [{arch}]"
    },
    {
      "type": "kernel",
      "key": " {#keys}│ {#title} {#@141}Kernel    ",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": " {#keys}│ {#title}󰅐 {#@141}Uptime    ",
      "format": "{formatted}"
    },
    {
      "type": "custom",
      "format": " {#keys}├──── {#@81}󱂬  DESKTOP {#keys}──────────────────────────────────┤"
    },
    {
      "type": "wm",
      "detectPlugin": true,
      "key": " {#keys}│ {#@81}󱂬 {#@208}WM        ",
      "format": "{pretty-name}{?version} ({version}){?}"
    },
    {
      "type": "shell",
      "key": " {#keys}│ {#@81}󰞷 {#@208}Shell     ",
      "format": "{pretty-name}{?version} {version}{?}"
    },
    {
      "type": "terminal",
      "key": " {#keys}│ {#@81} {#@208}Terminal  ",
      "format": "{pretty-name}{?version} {version}{?}"
    },
    {
      "type": "terminalfont",
      "key": " {#keys}│ {#@81} {#@208}Font      ",
      "format": "{name}{?size} ({size}){?}"
    },
    {
      "type": "theme",
      "key": " {#keys}│ {#@81}󰏘 {#@208}Theme     ",
      "format": "{theme1}{?theme2} ({theme2}){?}"
    },
    {
      "type": "icons",
      "key": " {#keys}│ {#@81}󰀻 {#@208}Icons     ",
      "format": "{icons1}{?icons2} ({icons2}){?}"
    },
    {
      "type": "cursor",
      "key": " {#keys}│ {#@81}󰳽 {#@208}Cursor    ",
      "format": "{theme}{?size} ({size}){?}"
    },
    {
      "type": "custom",
      "format": " {#keys}├──── {#@178}󰍹  RESOURCES {#keys}────────────────────────────────┤"
    },
    {
      "type": "cpu",
      "temp": false,
      "showPeCoreCount": false,
      "key": " {#keys}│ {#@178} {#@69}CPU       ",
      "format": "{name}"
    },
    {
      "type": "cpuusage",
      "key": " {#keys}│ {#separator}   └─{#@111}Usage  ",
      "format": "{avg-bar}"
    },
    {
      "type": "gpu",
      "temp": false,
      "driverSpecific": true,
      "detectionMethod": "pci",
      "hideType": "integrated",
      "key": " {#keys}│ {#@178}󰢮 {#@69}GPU       ",
      "format": "{name} {#separator}"
    },
    {
      "type": "memory",
      "key": " {#keys}│ {#@178}󰍛 {#@69}RAM       ",
      "format": "{used} / {total}"
    },
    {
      "type": "memory",
      "key": " {#keys}│ {#separator}   └─{#@111}Usage  ",
      "format": "{percentage-bar}"
    },
    {
      "type": "display",
      "key": " {#keys}│ {#@178}󰍹 {#@69}Display   ",
      "format": "{width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": " {#keys}│ {#@178}󰋊 {#@69}Main      ",
      "format": "{size-used} / {size-total} [{filesystem}]"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": " {#keys}│ {#separator}   └─{#@111}Usage  ",
      "format": "{size-percentage-bar}"
    },
    {
      "type": "custom",
      "format": " {#keys}├──── {#@141}󰏗  SOFTWARE {#keys}─────────────────────────────────┤"
    },
    {
      "type": "custom",
      "format": " {#keys}│ {#@141}󰏗 {#@148}Packages"
    },
    {
      "type": "packages",
      "key": " {#keys}│ {#separator}   ├─{#@226}󰏖 {#@193}System",
      "format": "{#title}{?pacman}{pacman}{?}{?rpm}{rpm}{?}{?xbps}{xbps}{?}{#output}"
    },
    {
      "type": "packages",
      "key": " {#keys}│ {#separator}   ├─{#@196}󰏔 {#@193}Flatpak",
      "format": "{#@208}{flatpak-all}{#output}"
    },
    {
      "type": "packages",
      "key": " {#keys}│ {#separator}   └─{#@193}Total  ",
      "format": "{#@33}{all}{#output}"
    },
    {
      "type": "custom",
      "format": " {#keys}╰──────────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "custom",
      "format": "  {#@232}☠ {#@52}☠ {#@88}☠ {#@124}☠ {#@160}☠ {#@196}☠ {#@202}☠ {#@208}☠ {#@214}☠ {#@220}☠ {#@214}☠ {#@208}☠ {#@202}☠ {#@196}☠ {#@160}☠ {#@124}☠ {#@88}☠ {#@52}☠ {#@232}☠{#output}"
    }
  ]
}
