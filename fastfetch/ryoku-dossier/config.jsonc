// Ryoku Dossier - an editorial system readout in vermillion on warm paper tones.
// Colour lives only in display.color; every module borrows it through {#keys},
// {#title} and {#separator}, so one palette swap repaints the whole readout.
// ryoku:recolor keys=primary title=foreground separator=outline
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "color": {
      "keys": "#e2342a",
      "title": "#f3ede1",
      "separator": "#8f8770"
    },
    "key": { "width": 9 },
    "separator": "  ",
    "percent": {
      "type": 9,
      "color": {
        "green": "#7fbf6a",
        "yellow": "#d9a441",
        "red": "#e2342a"
      }
    }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{#1;title}{user-name}{#}{#separator} @ {#}{#1;title}{host-name}{#}" },
    { "type": "custom", "format": "{#keys}\u25a0{#} {#separator}RYOKU \u00b7 \u529b \u00b7 a hand-built {$RYOKU_BASE_OS} desktop{#}" },
    "break",
    { "type": "custom", "format": "{#keys}\u2500\u2500{#} {#1;title}VITALS{#} {#38;2;58;46;36}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500{#}" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU", "detectionMethod": "pci" },
    { "type": "memory", "key": "MEMORY" },
    { "type": "disk", "key": "DISK" },
    "break",
    { "type": "custom", "format": "{#keys}\u2500\u2500{#} {#1;title}SYSTEM{#} {#38;2;58;46;36}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500{#}" },
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "KERNEL" },
    { "type": "wm", "key": "WM" },
    { "type": "shell", "key": "SHELL" },
    { "type": "packages", "key": "PKGS" },
    "break",
    { "type": "custom", "format": "{#keys}\u2500\u2500{#} {#1;title}SESSION{#} {#38;2;58;46;36}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500{#}" },
    { "type": "uptime", "key": "UPTIME" },
    { "type": "terminal", "key": "TERM" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
    "break"
  ]
}
