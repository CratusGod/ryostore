// Grimoire - rounded monochrome card beside the distribution's logo, labels left, values right-aligned
// Ported for Ryoku from awesome-fastfetch-collection (configs/friefetch), MIT.
// ryoku:recolor keys=foreground
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "builtin", "padding": { "top": 2, "right": 4, "left": 2 } },
  "display": { "separator": "  ", "color": { "keys": "#e6e6e6" } },
  "modules": [
    "break",
    { "type": "custom", "format": "{#keys}╭─────────────────────────────────────────╮" },
    { "type": "custom", "format": "{#keys}│                                         │" },
    { "type": "os", "key": "│  OS           ", "format": "{pretty-name>22}  │" },
    { "type": "kernel", "key": "│  Kernel       ", "format": "{release>22}  │" },
    { "type": "uptime", "key": "│  Uptime       ", "format": "{formatted>22}  │" },
    { "type": "shell", "key": "│  Shell        ", "format": "{pretty-name>22}  │" },
    { "type": "wm", "key": "│  WM           ", "format": "{pretty-name>22}  │" },
    { "type": "memory", "key": "│  Ram          ", "format": "{used>9} / {total>10}  │" },
    { "type": "cpu", "key": "│  CPU          ", "format": "{name>22}  │" },
    { "type": "disk", "key": "│  Disk         ", "format": "{size-used>10}/{size-total>11}  │" },
    { "type": "packages", "key": "│  Packages     ", "format": "{all>22}  │" },
    { "type": "title", "key": "│  Owner        ", "format": "{user-name>22}  │" },
    { "type": "custom", "format": "{#keys}│                                         │" },
    { "type": "custom", "format": "{#keys}│             WE ARE LIBRE !              │" },
    { "type": "custom", "format": "{#keys}╰─────────────────────────────────────────╯" },
    "break"
  ]
}
