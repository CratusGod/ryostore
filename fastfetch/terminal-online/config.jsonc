// Terminal Online - a TERMINAL ONLINE banner over two bordered CPU/OS panels
// Ported for Ryoku from awesome-fastfetch-collection (configs/kitty-cachyos/config.jsonc), MIT.
// ryoku:recolor keys=primary
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.local/share/ryoku/fastfetch/terminal-online/girl.png",
    "width": 14,
    "height": 11,
    "padding": {
      "left": 2,
      "right": 3,
      "top": 1
    }
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 18
    },
    "color": {
      "keys": "#ff5555"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1;31m 󰊠 \u001b[1;35m󰊠 \u001b[1;36m󰊠 \u001b[1;33m󰮯 \u001b[0;33m· · · · \u001b[1;38;5;208mTERMINAL \u001b[1;32mONLINE"
    },
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "    OS",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "  󰌽  Kernel",
      "format": "{2}"
    },
    {
      "type": "packages",
      "key": "  󰏖  Packages"
    },
    {
      "type": "display",
      "key": "  󰍹  Display",
      "keyColor": "green",
      "format": "{1}x{2} @ {3}Hz"
    },
    {
      "type": "wm",
      "key": "  󰨇  WM",
      "keyColor": "green",
      "format": "{2}"
    },
    {
      "type": "de",
      "key": "  󰧨  DE",
      "keyColor": "green",
      "format": "{2}"
    },
    {
      "type": "terminal",
      "key": "  󰆍  Terminal",
      "keyColor": "yellow",
      "format": "{3}"
    },
    {
      "type": "shell",
      "key": "  󰞷  Shell",
      "keyColor": "yellow",
      "format": "{1}"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "title",
      "format": "  \u001b[35m󰧂  {1}@{2}"
    },
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────┐"
    },
    {
      "type": "cpu",
      "key": "  󰻠  CPU",
      "keyColor": "blue",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "  󰢮  GPU",
      "keyColor": "blue",
      "format": "{1} {2}"
    },
    {
      "type": "memory",
      "key": "  󰍛  Memory",
      "keyColor": "blue",
      "format": "{1} / {2} {3}"
    },
    {
      "type": "uptime",
      "key": "  󰅐  Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
