// Install Log - nerd-font icon keys, cyan accent, ANSI palette swatch footer
// Ported for Ryoku from awesome-fastfetch-collection (configs/2.jsonc), MIT.
// ryoku:recolor keys=primary
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "padding": { "top": 2, "right": 2 }
  },
  "display": {
    "color": {
      "keys": "#56b6c2"
    }
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "\uf31a "
    },
    {
      "type": "kernel",
      "key": "\uf013 "
    },
    {
      "type": "packages",
      "key": "\ueb29 "
    },
    {
      "type": "shell",
      "key": "\uf120 "
    },
    {
      "type": "terminal",
      "key": "\uf489 "
    },
    {
      "type": "wm",
      "key": "\uf488 "
    },
    {
      "type": "display",
      "key": "\uf109 "
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": "\uf493 "
    },
    {
      "type": "gpu",
      "format": "{2}",
      "key": "\uf51e "
    },
    {
      "type": "memory",
      "key": "\udb80\udf5b "
    },
    {
      "type": "swap",
      "key": "\udb83\udfb4 "
    },
    {
      "type": "disk",
      "key": "\uf1bf "
    },
    {
      "type": "uptime",
      "key": "\ue385 "
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
    },
    "break"
  ]
}
