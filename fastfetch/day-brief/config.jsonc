// Day Brief - datetime header then a colour-coded rundown: system, hardware, disk, software, net, audio
// Ported for Ryoku from awesome-fastfetch-collection (configs/8.jsonc), MIT.
// ryoku:recolor keys=primary output=onSurface
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small"
  },
  "display": {
    "separator": " \u279c  ",
    "percent": {
      "type": 2
    },
    "key": {
      "width": 20
    },
    "color": {
      "keys": "#00cdcd",
      "output": "#e6e6e6"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "datetime",
      "key": "\udb80\udced  Date & Time",
      "format": "{1}-{4}-{11} · {14}:{18}"
    },
    {
      "type": "break"
    },
    {
      "type": "os",
      "key": "\udb80\udf3d Distro",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "\uf013 Kernel",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": "\uf488 DE",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "\udb84\udfab Uptime",
      "keyColor": "blue"
    },
    {
      "type": "break"
    },
    {
      "type": "cpu",
      "key": "\uf4bc CPU",
      "temp": true,
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "key": "\udb82\udcae GPU",
      "temp": true,
      "keyColor": "yellow"
    },
    {
      "type": "board",
      "key": "\udb82\udcae Motherboard",
      "keyColor": "yellow"
    },
    {
      "type": "bios",
      "key": "\udb83\udfb2 BIOS",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "\udb80\udf5b RAM",
      "keyColor": "yellow"
    },
    {
      "type": "break"
    },
    {
      "type": "disk",
      "key": "\udb85\udedf Disk",
      "folders": "/"
    },
    {
      "type": "break"
    },
    {
      "type": "display",
      "key": "\udb80\udf79 Display",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "\udb84\udd83 Shell",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "\uf489 Terminal",
      "keyColor": "green"
    },
    {
      "type": "terminalfont",
      "key": "\uf031 Font",
      "keyColor": "green"
    },
    {
      "type": "break"
    },
    {
      "type": "wifi",
      "key": "\uf1eb WiFi",
      "keyColor": "white"
    },
    {
      "type": "bluetooth",
      "key": "\uf293 Bluetooth",
      "keyColor": "white"
    },
    {
      "type": "break"
    },
    {
      "type": "sound",
      "key": "\udb84\udf5a Audio",
      "keyColor": "red"
    },
    {
      "type": "media",
      "key": "\udb81\udf5a Playing",
      "format": "{3} \u279c {1}",
      "keyColor": "red"
    },
    {
      "type": "break"
    },
    {
      "type": "colors",
      "key": "\ue22b Colors",
      "symbol": "circle"
    }
  ]
}
