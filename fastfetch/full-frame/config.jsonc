// Full Frame - a wide grey box framing blue-dot system lines beside the distribution's small logo
// Ported for Ryoku from awesome-fastfetch-collection (configs/sofijacom-config/config.jsonc), MIT.
// ryoku:recolor keys=primary
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "left": 1,
      "right": 3,
      "top": 1
    }
  },
  "display": {
    "separator": " ▸ ",
    "color": {
      "keys": "#4c8edf"
    }
  },
  "modules": [
    {
      "type": "title"
    },
    "break",
    {
      "type": "custom",
      "format": "{#90}┌────────────────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": ""
    },
    {
      "type": "kernel",
      "key": ""
    },
    {
      "type": "de",
      "key": ""
    },
    {
      "type": "wm",
      "key": ""
    },
    {
      "type": "packages",
      "key": ""
    },
    {
      "type": "custom",
      "format": "{#90}├────────────────────────────────────────────────────┤"
    },
    {
      "type": "memory",
      "key": ""
    },
    {
      "type": "host",
      "key": ""
    },
    {
      "type": "cpu",
      "key": ""
    },
    {
      "type": "gpu",
      "key": ""
    },
    {
      "type": "swap",
      "key": ""
    },
    {
      "type": "disk",
      "key": ""
    },
    {
      "type": "battery",
      "key": ""
    },
    {
      "type": "custom",
      "format": "{#90}├────────────────────────────────────────────────────┤"
    },
    {
      "type": "uptime",
      "key": ""
    },
    {
      "type": "terminal",
      "key": ""
    },
    {
      "type": "locale",
      "key": ""
    },
    {
      "type": "custom",
      "format": "{#90}└────────────────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },
    "break"
  ]
}
