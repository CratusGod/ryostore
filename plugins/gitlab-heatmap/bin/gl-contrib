#!/usr/bin/env python3
"""Print a GitLab user's public contribution calendar as JSON.

usage: gl-contrib <username> <year|last>

GitLab only exposes the rolling year: the public endpoint
https://gitlab.com/users/<user>/calendar.json answers {"YYYY-MM-DD": count}
with no token. The <year|last> argument is accepted for command-line parity
with gh-contrib, but the rolling year is always returned (year == "last").

Levels are computed here, not by GitLab: active-day counts are bucketed into
quartiles (0 = no activity, 1-4 = quartile of the user's own distribution).
"""
import json
import re
import sys
import urllib.error
import urllib.request

USAGE = "usage: gl-contrib <username> <year|last>"
# GitLab usernames allow letters, digits, '_', '.', '-'.
USER_RE = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,100})")


def levels(counts):
    """Map count -> level (0 for 0, 1-4 by quartile of the active days)."""
    lv = {0: 0}
    if not counts:
        return lv
    ordered = sorted(counts)
    n = len(ordered)

    def q(k):
        return ordered[min(n - 1, max(0, (k * n) // 4))]

    q1, q2, q3 = q(1), q(2), q(3)
    for c in set(counts):
        if c <= q1:
            lv[c] = 1
        elif c <= q2:
            lv[c] = 2
        elif c <= q3:
            lv[c] = 3
        else:
            lv[c] = 4
    return lv


def main():
    if len(sys.argv) != 3:
        print(json.dumps({"error": USAGE}))
        return 2
    user, _year = sys.argv[1].strip(), sys.argv[2].strip()
    if not USER_RE.fullmatch(user):
        print(json.dumps({"error": "invalid username"}))
        return 2
    url = f"https://gitlab.com/users/{user}/calendar.json"
    req = urllib.request.Request(url, headers={"User-Agent": "ryoku-gitlab-heatmap"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            raw = json.loads(r.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        # gitlab.com answers 404, and 403 for unknown users (its enumeration
        # guard); both mean "no such public user" for this widget.
        print(json.dumps({"error": "user not found" if e.code in (403, 404) else f"HTTP {e.code}"}))
        return 1
    except Exception as e:  # network down, DNS, timeout, bad JSON
        print(json.dumps({"error": f"network: {e.__class__.__name__}"}))
        return 1

    if not isinstance(raw, dict):
        print(json.dumps({"error": "bad response"}))
        return 1

    lv = levels([int(c) for c in raw.values() if int(c) > 0])
    days = [{
        "date": d,
        "count": int(raw[d]),
        "level": lv.get(int(raw[d]), 0),
    } for d in sorted(raw)]
    print(json.dumps({
        "user": user,
        "year": "last",  # GitLab serves the rolling year only
        "total": sum(d["count"] for d in days),
        "first": days[0]["date"] if days else "",
        "days": days,
    }))
    return 0


if __name__ == "__main__":
    sys.exit(main())
