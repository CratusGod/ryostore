{
  "id": "power-menu-v2",
  "name": "Power Menu V2",
  "version": "0.2.0",
  "author": "hectorbaez81 <hector.baez@gmail.com>",
  "description": "Profile-style session menu on the QS Bar: avatar, Ryoku version and uptime, plus lock, log out, suspend, hibernate, reboot and power off through Ryoku's session commands.",
  "license": "MIT",
  "official": false,
  "tags": [
    "session",
    "power",
    "bar-widget"
  ],
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 280
  },
  "files": [
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "icon": "power_settings_new",
    "label": "Power Menu V2"
  },
  "dependencies": {
    "commands": [
      "ryoku-shell",
      "ryoku-host",
      "busctl",
      "uname",
      "cat"
    ]
  },
  "metadata": {
    "settings": [
      {
        "key": "confirm",
        "type": "toggle",
        "label": "Ask before acting (click twice)",
        "group": "Behavior",
        "default": true
      },
      {
        "key": "show_lock",
        "type": "toggle",
        "label": "Show Lock",
        "group": "Actions",
        "default": true
      },
      {
        "key": "show_logout",
        "type": "toggle",
        "label": "Show Log out",
        "group": "Actions",
        "default": true
      },
      {
        "key": "show_suspend",
        "type": "toggle",
        "label": "Show Suspend",
        "group": "Actions",
        "default": true
      },
      {
        "key": "show_hibernate",
        "type": "toggle",
        "label": "Show Hibernate",
        "group": "Actions",
        "default": true
      },
      {
        "key": "show_reboot",
        "type": "toggle",
        "label": "Show Reboot",
        "group": "Actions",
        "default": true
      },
      {
        "key": "show_poweroff",
        "type": "toggle",
        "label": "Show Power off",
        "group": "Actions",
        "default": true
      }
    ]
  }
}
