{
  "id": "dragshift",
  "name": "DragShift",
  "version": "0.2.0",
  "author": "CratusGod <nghiabigg652@gmail.com>",
  "description": "DragShift on Wayland: start dragging a file, press Shift, and drop it on a liquid-glass radial menu to convert or edit it. Results land next to the originals, which are never changed.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 360
  },
  "files": [
    "assets/preview-widget.png",
    "NOTICE",
    "bin/dragshift",
    "bin/dragshift_engine.py",
    "bin/dragshift_editor.py",
    "content/urls.js",
    "engine/PIN",
    "service/menu.js",
    "service/MenuView.qml",
    "service/RadialMenu.qml",
    "service/CardView.qml",
    "service/Toasts.qml",
    "service/JobRunner.qml",
    "service/shaders/glass.frag.qsb",
    "service/shaders/ink.frag.qsb",
    "service/shaders/card.frag.qsb",
    "hypr/trigger.lua",
    "engine/setup.sh",
    "engine/update.sh",
    "engine/requirements.in",
    "engine/requirements.lock"
  ],
  "capabilities": {
    "densities": [
      "glyph"
    ],
    "network": [
      "github.com",
      "pypi.org",
      "files.pythonhosted.org"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "icon": "swap_horiz",
    "label": "DragShift"
  },
  "dependencies": {
    "commands": [
      "python3",
      "git",
      "gio",
      "xdg-open",
      "notify-send",
      "dbus-send",
      "stat",
      "qs"
    ]
  },
  "metadata": {
    "settings": [
      {
        "key": "engineDir",
        "type": "text",
        "label": "DragShift engine folder",
        "group": "DragShift",
        "default": "~/.local/share/dragshift/engine",
        "placeholder": "~/.local/share/dragshift/engine"
      },
      {
        "key": "output",
        "type": "choice",
        "label": "Save results",
        "group": "DragShift",
        "default": "next",
        "options": [
          {
            "value": "next",
            "label": "Next to the original"
          },
          {
            "value": "folder",
            "label": "In a DragShift subfolder"
          }
        ]
      },
      {
        "key": "barIcon",
        "type": "choice",
        "label": "Bar icon (drop target and panel)",
        "group": "DragShift",
        "default": "auto",
        "options": [
          {
            "value": "auto",
            "label": "Until Shift+drag is set up"
          },
          {
            "value": "on",
            "label": "Always"
          },
          {
            "value": "off",
            "label": "Never"
          }
        ]
      }
    ]
  },
  "tags": [
    "files",
    "convert",
    "images",
    "pdf",
    "compress",
    "dragshift"
  ],
  "commands": [
    "bin/dragshift"
  ]
}
