{
  "id": "prayer-times",
  "name": "Prayer Times",
  "version": "1.1.0",
  "author": "hshindys <hshindys@users.noreply.github.com>",
  "description": "Daily prayer times in the bar: a crescent mark with the next prayer and countdown. Click to open the panel (all six times, Hijri date, offline cache). Times by the Aladhan API; city and calculation method are configurable.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 320
  },
  "files": [
    "bin/prayers",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ],
    "network": [
      "api.aladhan.com"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "Prayer Times"
  },
  "dependencies": {
    "commands": [
      "python3",
      "notify-send",
      "paplay"
    ]
  },
  "metadata": {
    "settings": [
      {
        "key": "city",
        "type": "text",
        "label": "City",
        "group": "Prayer Times",
        "default": "Cairo",
        "placeholder": "Cairo"
      },
      {
        "key": "country",
        "type": "text",
        "label": "Country",
        "group": "Prayer Times",
        "default": "Egypt",
        "placeholder": "Egypt"
      },
      {
        "key": "method",
        "type": "choice",
        "label": "Calculation method",
        "group": "Prayer Times",
        "default": "5",
        "options": [
          {
            "value": "5",
            "label": "Egyptian General Authority"
          },
          {
            "value": "3",
            "label": "Muslim World League"
          },
          {
            "value": "2",
            "label": "ISNA (North America)"
          },
          {
            "value": "1",
            "label": "Karachi"
          },
          {
            "value": "4",
            "label": "Umm al-Qura (Makkah)"
          },
          {
            "value": "13",
            "label": "Diyanet (Turkey)"
          },
          {
            "value": "16",
            "label": "UAE"
          }
        ]
      },
      {
        "key": "school",
        "type": "choice",
        "label": "Asr calculation",
        "group": "Prayer Times",
        "default": "0",
        "options": [
          {
            "value": "0",
            "label": "Shafi'i / Maliki / Hanbali"
          },
          {
            "value": "1",
            "label": "Hanafi"
          }
        ]
      },
      {
        "key": "use12h",
        "type": "toggle",
        "label": "12-hour clock in panel",
        "group": "Prayer Times",
        "default": true
      },
      {
        "key": "remind",
        "type": "toggle",
        "label": "Alert before prayer",
        "group": "Reminders",
        "default": true
      },
      {
        "key": "remindMin",
        "type": "int",
        "label": "Minutes before",
        "group": "Reminders",
        "default": 5,
        "min": 1,
        "max": 30
      },
      {
        "key": "remindSound",
        "type": "toggle",
        "label": "Alert sound",
        "group": "Reminders",
        "default": true
      }
    ]
  }
}
