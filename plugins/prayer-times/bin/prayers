#!/usr/bin/env python3
"""Fetch today's prayer times from the Aladhan API, with disk-cache fallback.

Usage: prayers <city> <country> <method> <school>
Prints one JSON object: {"date", "hijri", "times": {Fajr..Isha}}.
On network failure the last cached day is printed with "stale": true.
Exits 1 only when there is neither network nor cache.
Cache lives under $XDG_CACHE_HOME/ryoku/plugins/prayer-times/.
"""

import json
import os
import sys
import urllib.parse
import urllib.request

ORDER = ["Fajr", "Sunrise", "Dhuhr", "Asr", "Maghrib", "Isha"]


def cache_path():
    base = os.environ.get(
        "XDG_CACHE_HOME", os.path.join(os.path.expanduser("~"), ".cache")
    )
    d = os.path.join(base, "ryoku", "plugins", "prayer-times")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, "timings.json")


def main():
    city = sys.argv[1] if len(sys.argv) > 1 else "Cairo"
    country = sys.argv[2] if len(sys.argv) > 2 else "Egypt"
    method = sys.argv[3] if len(sys.argv) > 3 else "5"
    school = sys.argv[4] if len(sys.argv) > 4 else "0"
    cp = cache_path()
    q = urllib.parse.urlencode(
        {"city": city, "country": country, "method": method, "school": school}
    )
    try:
        req = urllib.request.Request(
            "https://api.aladhan.com/v1/timingsByCity?" + q,
            headers={"User-Agent": "ryoku-prayer-times/1.0"},
        )
        with urllib.request.urlopen(req, timeout=20) as r:
            payload = json.load(r)["data"]
        out = {
            "date": payload["date"]["readable"],
            "hijri": "%s %s %s"
            % (
                payload["date"]["hijri"]["day"],
                payload["date"]["hijri"]["month"]["en"],
                payload["date"]["hijri"]["year"],
            ),
            "times": {k: payload["timings"][k][:5] for k in ORDER},
        }
        with open(cp, "w") as f:
            json.dump(out, f)
    except Exception:
        try:
            with open(cp) as f:
                out = json.load(f)
            out["stale"] = True
        except Exception as exc:
            print(json.dumps({"error": "fetch failed and no cache: %s" % exc}))
            return 1
    print(json.dumps(out))
    return 0


sys.exit(main())
