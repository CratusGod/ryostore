#!/usr/bin/env python3
"""Fetch today's prayer times from the Aladhan API, with disk-cache fallback.

Usage: prayers <city> <country> <method> <school> <state-dir>
Prints one JSON object: {"date", "hijri", "times": {Fajr..Isha}}.
On network failure the last cached day is printed with "stale": true.
Exits 1 only when there is neither network nor cache.
Cache lives in the plugin state directory supplied by Ryoku.
"""

import json
import os
import sys
import tempfile
import urllib.parse
import urllib.request

ORDER = ["Fajr", "Sunrise", "Dhuhr", "Asr", "Maghrib", "Isha"]


def cache_path(state_dir):
    os.makedirs(state_dir, mode=0o700, exist_ok=True)
    return os.path.join(state_dir, "timings.json")


def write_cache(path, value):
    fd, temporary = tempfile.mkstemp(
        prefix=".timings.", suffix=".tmp", dir=os.path.dirname(path), text=True
    )
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(value, f)
            f.flush()
            os.fsync(f.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    city = sys.argv[1] if len(sys.argv) > 1 else "Cairo"
    country = sys.argv[2] if len(sys.argv) > 2 else "Egypt"
    method = sys.argv[3] if len(sys.argv) > 3 else "5"
    school = sys.argv[4] if len(sys.argv) > 4 else "0"
    state_dir = sys.argv[5] if len(sys.argv) > 5 else ""
    if not state_dir:
        print(json.dumps({"error": "plugin state directory is required"}))
        return 1
    cp = cache_path(state_dir)
    q = urllib.parse.urlencode(
        {"city": city, "country": country, "method": method, "school": school}
    )
    try:
        req = urllib.request.Request(
            "https://api.aladhan.com/v1/timingsByCity?" + q,
            headers={"User-Agent": "ryoku-prayer-times/1.0"},
        )
        with urllib.request.urlopen(req, timeout=20) as r:
            payload = json.load(r)["data"]
        out = {
            "date": payload["date"]["readable"],
            "hijri": "%s %s %s"
            % (
                payload["date"]["hijri"]["day"],
                payload["date"]["hijri"]["month"]["en"],
                payload["date"]["hijri"]["year"],
            ),
            "times": {k: payload["timings"][k][:5] for k in ORDER},
        }
        write_cache(cp, out)
    except Exception:
        try:
            with open(cp) as f:
                out = json.load(f)
            out["stale"] = True
        except Exception as exc:
            print(json.dumps({"error": "fetch failed and no cache: %s" % exc}))
            return 1
    print(json.dumps(out))
    return 0


sys.exit(main())
